---
import "../styles/global.css";
import "katex/dist/katex.min.css";
import NavBar from "../components/NavBar.astro";
import TocSidebar from "../components/TocSidebar.astro";
const { title = "The Hearth of Dev" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var sys = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', stored || sys);
      })();
    </script>
  </head>
  <body>
    <NavBar />
    <TocSidebar />
    <main class="prose-layout">
      <slot />
    </main>
    <script type="module" is:inline>
      const diagrams = document.querySelectorAll('.mermaid');
      if (diagrams.length > 0) {
        const { default: mermaid } = await import(
          'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs'
        );

        // Capture the original definition HTML before mermaid replaces it with SVG
        diagrams.forEach(el => { el.dataset.src = el.innerHTML; });

        function render() {
          const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
          mermaid.initialize({ startOnLoad: false, theme: isDark ? 'dark' : 'base' });
          diagrams.forEach(el => {
            el.removeAttribute('data-processed');
            el.innerHTML = el.dataset.src;       // restore original definition
          });
          mermaid.run({ querySelector: '.mermaid' });
        }

        render();

        // Re-render whenever the site theme is toggled
        new MutationObserver(render).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });
      }
    </script>
  </body>
</html>
